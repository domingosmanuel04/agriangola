# AgriAngola OS — environment
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-in-production-use-a-long-random-secret
JWT_EXPIRES_IN=7d

DATABASE_URL=postgresql://agriangola:agriangola@localhost:5432/agriangola?schema=public
REDIS_URL=redis://localhost:6389

# Optional LLM for AgriAI (rule-based engine works without this)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Maps (Leaflet/OSM works without a key)
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

S3_ENDPOINT=
S3_BUCKET=agriangola
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=af-south-1
